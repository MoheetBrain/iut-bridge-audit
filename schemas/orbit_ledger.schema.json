        "type": "string"
      },
      "origin": {
        "type": "string"
      },
      "acts_on": {
        "type": "string"
      },
      "action_on_S": {
        "type": "string"
      },
      "action_on_eta_anab": {
        "type": "string"
      },
      "invariant_properties": {
        "type": "string"
      },
      "potentially_changed_properties": {
        "type": "string"
      },
      "exact/provisional": {
        "type": "string"
      },
      "source": {
        "type": "string"
      },
      "notes": {
        "type": "string"
      },
      "source_ids": {
        "type": "string"
      },
      "evidence_type": {
        "type": "string",
        "enum": [
          "SOURCE FACT",
          "SOURCE CLAIM",
          "RECONSTRUCTION",
          "INFERENCE",
          "OPEN QUESTION"
        ]
      },
      "claim_ids": {
        "type": "string"
      }
    }
  }
}
