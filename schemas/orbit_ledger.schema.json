{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "orbit_ledger",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "transformation_id",
      "origin",
      "acts_on",
      "action_on_S",
      "action_on_eta_anab",
      "invariant_properties",
      "potentially_changed_properties",
      "exact/provisional",
      "source",
      "notes",
      "source_ids",
      "evidence_type",
      "claim_ids"
