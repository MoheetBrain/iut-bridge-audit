{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "claim_registry",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "claim_id",
      "exact_claim",
      "status",
      "source_id",
      "location",
      "evidence_type",
      "confidence",
      "notes"
    ],
    "additionalProperties": false,
    "properties": {
      "claim_id": {
        "type": "string"
      },
      "exact_claim": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "VERIFIED_PRIMARY",
          "VERIFIED_SECONDARY",
          "SOURCE_CLAIM_ONLY",
          "RECONSTRUCTION",
          "HYPOTHESIS",
          "UNRESOLVED",
          "CONTRADICTED"
        ]
      },
      "source_id": {
        "type": "string"
      },
      "location": {
        "type": "string"
      },
      "evidence_type": {
        "type": "string",
        "enum": [
          "SOURCE FACT",
          "SOURCE CLAIM",
          "RECONSTRUCTION",
          "INFERENCE",
          "OPEN QUESTION"
        ]
      },
      "confidence": {
        "type": "string"
      },
      "notes": {
        "type": "string"
      }
    }
  }
}
