{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "open_questions",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "question_id",
      "title",
      "source_ids",
      "source_location",
      "status",
      "required_resolution",
      "evidence_type",
      "claim_ids"
    ],
    "additionalProperties": false,
    "properties": {
      "question_id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "source_ids": {
        "type": "string"
      },
      "source_location": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "required_resolution": {
        "type": "string"
      },
      "evidence_type": {
        "type": "string",
        "enum": [
          "SOURCE FACT",
          "SOURCE CLAIM",
          "RECONSTRUCTION",
          "INFERENCE",
          "OPEN QUESTION"
        ]
      },
      "claim_ids": {
        "type": "string"
      }
    }
  }
}
